<Window x:Class="DAMeter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DAMeter.Controls"
        Title="DAMeter" Width="960" Height="640" MinWidth="320" MinHeight="240"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" WindowStartupLocation="Manual"
        FontFamily="Yu Gothic UI, Segoe UI" FontSize="13" Language="ja-JP"
        Foreground="#EDF3F6" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    </Window.Resources>
    <Grid x:Name="Surface">
        <Grid.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="横型ピーク" Command="{Binding SelectMeterCommand}" CommandParameter="HorizontalPeak" />
                <MenuItem Header="縦型ピーク" Command="{Binding SelectMeterCommand}" CommandParameter="VerticalPeak" />
                <MenuItem Header="アナログ VU" Command="{Binding SelectMeterCommand}" CommandParameter="AnalogVu" />
                <Separator />
                <MenuItem Header="フローティング表示" IsCheckable="True" IsChecked="{Binding Floating}" />
                <MenuItem Header="通常表示に戻す" Click="ReturnToNormal" />
                <MenuItem Header="常に最前面" IsCheckable="True" IsChecked="{Binding Topmost}" />
                <MenuItem Header="クリック透過（解除はトレイから）" IsCheckable="True" IsChecked="{Binding ClickThrough}" IsEnabled="{Binding Floating}" />
                <MenuItem Header="設定" Command="{Binding SettingsCommand}" />
                <MenuItem Header="終了" Click="ExitApplication" />
            </ContextMenu>
        </Grid.ContextMenu>
        <Border Background="#111923" CornerRadius="10" Opacity="{Binding BackgroundOpacity}" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="DragWindow"
                  Visibility="{Binding Normal, Converter={StaticResource BoolVisibility}}">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="20,15">
                    <TextBlock Text="DA" Foreground="#59E4B1" FontWeight="Bold" FontSize="23" />
                    <TextBlock Text="Meter" FontSize="23" />
                    <TextBlock Text="SYSTEM AUDIO" Margin="15,10,0,0" FontSize="10" Foreground="#97A9B9" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Content="—" Click="MinimizeWindow" ToolTip="最小化" />
                    <Button Content="×" Click="HideWindow" ToolTip="通知領域に隠す（終了はトレイメニュー）" />
                </StackPanel>
            </Grid>
            <WrapPanel Grid.Row="1" Margin="14,0,14,8" Visibility="{Binding Normal, Converter={StaticResource BoolVisibility}}">
                <Button Content="横型ピーク" Command="{Binding SelectMeterCommand}" CommandParameter="HorizontalPeak" />
                <Button Content="縦型ピーク" Command="{Binding SelectMeterCommand}" CommandParameter="VerticalPeak" />
                <Button Content="アナログ VU" Command="{Binding SelectMeterCommand}" CommandParameter="AnalogVu" />
                <ComboBox ItemsSource="{Binding Devices}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedDevice}"
                          Width="240" Margin="8,4" VerticalContentAlignment="Center" ToolTip="再生デバイス" />
                <Button Content="更新" Command="{Binding RefreshDevicesCommand}" />
                <CheckBox Content="最前面" IsChecked="{Binding Topmost}" VerticalAlignment="Center" Margin="8" />
                <Button Content="浮動表示" Command="{Binding ToggleFloatingCommand}" />
                <Button Content="設定" Command="{Binding SettingsCommand}" />
            </WrapPanel>
            <controls:MeterDisplay x:Name="Meter" Grid.Row="2" Margin="8" MouseLeftButtonDown="DragWindow" />
            <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#A6B7C8" Margin="20,8,32,14"
                       TextTrimming="CharacterEllipsis" Visibility="{Binding Normal, Converter={StaticResource BoolVisibility}}" />
        </Grid>
        <Thumb HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="18" Height="18"
               Cursor="SizeNWSE" DragDelta="ResizeWindow" DragCompleted="ResizeCompleted" ToolTip="ドラッグしてサイズ変更">
            <Thumb.Template><ControlTemplate><Border Background="#303F4D" CornerRadius="0,0,8,0"><TextBlock Text="◢" Foreground="#9AAABB" HorizontalAlignment="Center" /></Border></ControlTemplate></Thumb.Template>
        </Thumb>
    </Grid>
</Window>
