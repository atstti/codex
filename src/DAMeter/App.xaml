<Application x:Class="DAMeter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#25313D" />
            <Setter Property="Foreground" Value="#EDF3F6" />
            <Setter Property="BorderBrush" Value="#465463" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#35495B" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Background" Value="#3F6170" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#59E4B1" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EDF3F6" /></Style>
        <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#111923" /></Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#111923" /></Style>
    </Application.Resources>
</Application>
