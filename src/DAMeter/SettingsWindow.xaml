<Window x:Class="DAMeter.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DAMeter 設定" Width="470" Height="600" MinWidth="390" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#18222E" Foreground="#EDF3F6"
        FontFamily="Yu Gothic UI, Segoe UI" FontSize="14" ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="表示・応答の設定" FontSize="23" Margin="0,0,0,22" />
            <CheckBox Content="常に最前面" IsChecked="{Binding Topmost}" Margin="0,0,0,18" />
            <TextBlock Text="フローティング背景の不透明度（0～100%）" />
            <Slider Minimum="0" Maximum="1" Value="{Binding FloatingBackgroundOpacity}" TickFrequency="0.05" Margin="0,12,0,0" />
            <TextBlock Text="{Binding FloatingBackgroundOpacity, StringFormat={}{0:P0}}" Margin="0,0,0,18" />
            <TextBlock Text="ピークホールド（秒）" />
            <Slider Minimum="0" Maximum="10" Value="{Binding PeakHoldSeconds}" TickFrequency="0.1" Margin="0,12,0,0" />
            <TextBlock Text="{Binding PeakHoldSeconds, StringFormat={}{0:F1} 秒}" Margin="0,0,0,18" />
            <TextBlock Text="ピーク減衰速度（dB/秒）" />
            <Slider Minimum="1" Maximum="120" Value="{Binding DecayDbPerSecond}" Margin="0,12,0,0" />
            <TextBlock Text="{Binding DecayDbPerSecond, StringFormat={}{0:F0} dB/秒}" Margin="0,0,0,18" />
            <TextBlock Text="VU 基準レベル（dBFS = 0 VU）" />
            <Slider Minimum="-60" Maximum="0" Value="{Binding VuReferenceDb}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,12,0,0" />
            <TextBlock Text="{Binding VuReferenceDb, StringFormat={}{0:F0} dBFS}" Margin="0,0,0,18" />
            <TextBlock Text="VU 表示は約300msで応答する RMS ベースの近似です。厳密な規格準拠 VU メーターではありません。" TextWrapping="Wrap" Foreground="#A6B7C8" Margin="0,0,0,14" />
            <TextBlock Text="クリック透過の解除や通常表示への復帰は、通知領域の DAMeter アイコンから操作できます。音声の録音・保存・外部送信は行いません。" TextWrapping="Wrap" Foreground="#A6B7C8" />
            <Button Content="閉じる" HorizontalAlignment="Right" Padding="24,8" Margin="0,22,0,0" Click="CloseSettings" />
        </StackPanel>
    </ScrollViewer>
</Window>
