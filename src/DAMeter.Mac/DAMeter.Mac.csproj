<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>DAMeter.Mac</AssemblyName>
    <RootNamespace>DAMeter.Mac</RootNamespace>
    <ApplicationTitle>DAMeter</ApplicationTitle>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DAMeter.Core/DAMeter.Core.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
</Project>
